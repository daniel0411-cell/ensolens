{
  "name": "ensolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=.wrangler/logs astro dev --host 127.0.0.1",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs astro build",
    "preview": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --local-upstream localhost --port 4327 --test-scheduled",
    "check": "WRANGLER_LOG_PATH=.wrangler/logs astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build",
    "data:refresh": "node scripts/refresh-data.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "deploy": "npm run verify && npm run test:browser && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@lucide/astro": "1.59.0",
    "astro": "7.4.0",
    "chart.js": "^4.5.0",
    "cheerio": "^1.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  }
}
