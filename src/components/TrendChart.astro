---
import { Download, ArrowUpRight } from '@lucide/astro';
import { formatDate, type Snapshot } from '../lib/enso';
interface Props { snapshot: Snapshot }
const { snapshot } = Astro.props;
const payload = JSON.stringify({ weekly: snapshot.weekly.data, roni: snapshot.roni.data, retrievedAt: { weekly: snapshot.weekly.retrievedAt, roni: snapshot.roni.retrievedAt } }).replace(/</g, '\\u003c');
---
<section class="trend-section" aria-labelledby="trend-heading">
  <div class="section-heading"><div><span class="eyebrow">OCEAN SIGNAL</span><h2 id="trend-heading">Tracking the temperature shift</h2></div><button class="icon-button download-data" title="Download official trend data (CSV)" aria-label="Download official trend data as CSV"><Download size={17} /></button></div>
  <div class="chart-toolbar"><div class="chart-legend"><span><i class="legend-dot warm"></i>Weekly Niño 3.4</span><span><i class="legend-dash"></i>Seasonal RONI</span></div><div class="segmented" role="group" aria-label="Trend time range"><button data-range="6" aria-pressed="false">6M</button><button class="selected" data-range="12" aria-pressed="true">12M</button></div></div>
  <div class="line-chart-wrap"><canvas id="trend-chart" role="img" aria-label="Observed weekly Niño 3.4 anomalies and three-month seasonal RONI on their own observation dates, in degrees Celsius"></canvas></div>
  <script id="trend-data" type="application/json" set:html={payload} />
  <div class="chart-footer"><span>WEEKLY THROUGH {formatDate(snapshot.weekly.data.at(-1)!.date)} · °C</span><div class="chart-footer-links"><a href="/historical/">Compare with 1997 & 2015 benchmarks <ArrowUpRight size={13} /></a><a href="/methodology/#indices">Why do these lines differ? <ArrowUpRight size={13} /></a></div></div>
  <p class="figure-note">RONI points are dated at the end of each three-month season. Weekly anomalies and RONI use different baselines and observation windows.</p>
  <p id="trend-live" class="sr-only" aria-live="polite">Showing 12 months of official observations.</p>
</section>
