---
import { Download, ArrowUpRight } from '@lucide/astro';
import { formatDate, signed, seasonLabel, type Snapshot } from '../lib/enso';
interface Props { snapshot: Snapshot }
const { snapshot } = Astro.props;
const payload = JSON.stringify({ weekly: snapshot.weekly.data, roni: snapshot.roni.data, retrievedAt: { weekly: snapshot.weekly.retrievedAt, roni: snapshot.roni.retrievedAt } }).replace(/</g, '\\u003c');
const latest = Math.max(Date.parse(snapshot.weekly.data.at(-1)!.date), Date.parse(snapshot.roni.data.at(-1)!.date));
const cutoff = new Date(latest);
cutoff.setUTCMonth(cutoff.getUTCMonth() - 12);
const rows = [
  ...snapshot.weekly.data.map(point => ({ date: point.date, period: `Week centered ${formatDate(point.date)}`, series: 'Weekly Niño 3.4', value: point.anomaly })),
  ...snapshot.roni.data.map(point => ({ date: point.date, period: `${seasonLabel(point)} · ending ${formatDate(point.date)}`, series: 'Seasonal RONI', value: point.value })),
].sort((a, b) => b.date.localeCompare(a.date) || a.series.localeCompare(b.series));
---
<section class="trend-section" aria-labelledby="trend-heading">
  <div class="section-heading"><div><span class="eyebrow">OCEAN SIGNAL</span><h2 id="trend-heading">Tracking the temperature shift</h2></div><button class="icon-button download-data" title="Download official trend data (CSV)" aria-label="Download official trend data as CSV"><Download size={17} /></button></div>
  <div class="chart-toolbar"><div class="chart-legend"><span><i class="legend-dot warm"></i>Weekly Niño 3.4</span><span><i class="legend-dash"></i>Seasonal RONI</span></div><div class="segmented" role="group" aria-label="Trend time range"><button data-range="6" aria-pressed="false">6M</button><button class="selected" data-range="12" aria-pressed="true">12M</button></div></div>
  <div class="line-chart-wrap"><canvas id="trend-chart" role="img" aria-label="Observed weekly Niño 3.4 anomalies and three-month seasonal RONI on their own observation dates, in degrees Celsius. Values are available in the trend data table below." aria-describedby="trend-limits"></canvas></div>
  <script id="trend-data" type="application/json" set:html={payload} />
  <div class="chart-footer"><span>WEEKLY THROUGH {formatDate(snapshot.weekly.data.at(-1)!.date)} · °C</span><div class="chart-footer-links"><a href="/historical/">Compare with 1997 & 2015 benchmarks <ArrowUpRight size={13} /></a><a href="/methodology/#indices">Why do these lines differ? <ArrowUpRight size={13} /></a></div></div>
  <p id="trend-limits" class="figure-note">RONI points are dated at the end of each three-month season. Weekly anomalies and RONI use different baselines and observation windows.</p>
  <details class="trend-data-details">
    <summary>View trend data</summary>
    <div class="probability-table-wrap trend-table-wrap" role="region" aria-label="Trend observation values" tabindex="0">
      <table class="data-table" id="trend-table">
        <caption>Official observations · <span id="trend-table-range">12 months</span> · °C. Weekly dates are center weeks; seasonal dates are period ends.</caption>
        <thead><tr><th scope="col">Observation period</th><th scope="col">Series</th><th scope="col">Anomaly (°C)</th></tr></thead>
        <tbody>{rows.map(row => <tr data-trend-date={row.date} hidden={Date.parse(row.date) < +cutoff}><th scope="row">{row.period}</th><td>{row.series}</td><td>{signed(row.value)}</td></tr>)}</tbody>
      </table>
    </div>
  </details>
  <p id="trend-live" class="sr-only" aria-live="polite">Showing 12 months of official observations.</p>
</section>
