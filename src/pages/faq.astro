---
import Layout from '../layouts/Layout.astro';
import { CircleHelp, ChevronRight, Search, BookOpen, ArrowUpRight } from '@lucide/astro';

const faqs = [
  {
    id: 'enso-basics',
    category: 'fundamentals',
    categoryLabel: 'Fundamentals',
    question: 'What is ENSO and how does it drive global weather patterns?',
    answer: 'ENSO is a coupled ocean–atmosphere climate pattern in the tropical Pacific. In neutral conditions, easterly trade winds blow from east to west, helping maintain warm surface water in the western Pacific while cooler water rises through upwelling in the east. During El Niño, weaker trades allow warm water to spread eastward and tropical rainfall shifts toward the central and eastern Pacific. During La Niña, stronger trades favor cooler central and eastern equatorial Pacific waters. Changes in tropical rainfall and atmospheric heating can influence jet streams and seasonal weather elsewhere. The ocean and atmosphere influence each other; one warm week or a warm patch on a map is not a complete ENSO diagnosis.'
  },
  {
    id: 'el-nino-vs-la-nina',
    category: 'fundamentals',
    categoryLabel: 'Fundamentals',
    question: 'What is the fundamental difference between El Niño and La Niña?',
    answer: 'El Niño is the warm phase and La Niña the cool phase of ENSO in the central and eastern equatorial Pacific. El Niño generally has weaker easterly trade winds and a weaker Walker circulation, with tropical rainfall shifted eastward. La Niña generally has stronger easterly trades, a stronger Walker circulation and cooler waters farther east. The trades help move warm surface water westward; La Niña does not simply push a pool of cold water west across the ocean. Phase classification depends on the index, averaging period, persistence and atmospheric response, rather than a single ±0.5°C weekly reading. Regional effects vary with season and location, and are not always exact opposites.'
  },
  {
    id: 'alerts-explained',
    category: 'alerts',
    categoryLabel: 'NOAA Alerts & Forecasts',
    question: 'What is the difference between an ENSO Watch, Advisory, and Not Active status?',
    answer: 'CPC alert labels describe an operational assessment, rather than a threshold applied to a single weekly observation.\n• Watch: Conditions are favorable for El Niño or La Niña to develop within the next six months. The definition does not specify a universal 50% probability trigger.\n• Advisory: El Niño or La Niña conditions are observed and expected to continue. CPC considers a one-month relative Niño 3.4 anomaly of at least +0.5°C or at most -0.5°C, the expected three-month RONI threshold, and an observed atmospheric response.\n• Final Advisory: El Niño or La Niña conditions have ended.\n• Not Active: The ENSO Alert System is not active. This label alone does not establish that every ocean or atmospheric measure is exactly normal.\nThe five consecutive overlapping three-month seasons used in historical episode tables are not a waiting requirement for issuing an Advisory.'
  },
  {
    id: 'nino-34-threshold',
    category: 'data',
    categoryLabel: 'Indices & Methods',
    question: 'What is the Niño 3.4 region, and why is ±0.5°C the critical threshold?',
    answer: 'The Niño 3.4 region spans 5°N to 5°S and 170°W to 120°W in the equatorial Pacific. The ±0.5°C thresholds are classification conventions for seasonal ENSO indices, not a universal physical tipping point or a rule for labeling individual weeks. CPC historical episode tables require the threshold for at least five consecutive overlapping three-month seasons. Ocean-atmosphere coupling also matters when assessing ENSO conditions. In CPC\'s RONI strength product, El Niño categories are weak from +0.5 to below +1.0°C, moderate from +1.0 to below +1.5°C, strong from +1.5 to below +2.0°C, and very strong at +2.0°C or above.'
  },
  {
    id: 'oni-vs-roni',
    category: 'data',
    categoryLabel: 'Indices & Methods',
    question: 'What is the difference between ONI (Oceanic Niño Index) and RONI (Relative ONI)?',
    answer: 'ONI is the three-month running mean of Niño 3.4 sea-surface temperature anomalies, using centered 30-year base periods updated every five years. CPC\'s current RONI table uses ERSSTv6 and a 1991–2020 base period. RONI subtracts the tropical-mean anomaly (20°N–20°S) from Niño 3.4 and adjusts the difference so its variance matches the original Niño 3.4 index. This accounts for the tropical ocean background; it is not a fixed correction or a weekly measurement. Recent seasonal values can be revised. Compare events within the same index, dataset version, baseline method and averaging period.'
  },
  {
    id: 'super-el-nino',
    category: 'data',
    categoryLabel: 'Indices & Methods',
    question: 'What is a super El Niño, and can one warm week confirm it?',
    answer: '“Super El Niño” is a shorthand for an unusually intense event, not a separate category in CPC\'s strength-probability product. That product uses weak, moderate, strong and very strong categories based on three-month RONI, with very strong starting at +2.0°C. A weekly Niño 3.4 anomaly above +3°C cannot be substituted for seasonal RONI or establish a historical record on its own. Check the index, averaging period and baseline behind any strength claim. Stronger ENSO does not guarantee more severe weather at a particular location.'
  },
  {
    id: 'event-duration',
    category: 'fundamentals',
    categoryLabel: 'Fundamentals',
    question: 'How long do El Niño and La Niña episodes typically persist?',
    answer: 'El Niño and La Niña episodes typically last about 9–12 months, but some persist for years. Events often reach their largest amplitude near the end of the calendar year; development and decay do not follow a fixed April–July or next-spring schedule. La Niña can recur over consecutive winters, sometimes with neutral intervals between them. Duration alone does not establish a drought outcome in any region: season, location and the affected water store need separate evidence.'
  },
  {
    id: 'local-weather-guarantee',
    category: 'weather',
    categoryLabel: 'Weather & Hurricanes',
    question: 'Does a strong El Niño or La Niña guarantee extreme weather in my specific city?',
    answer: 'No. ENSO shifts seasonal regional odds rather than dictating daily weather. In Northern Hemisphere winter, El Niño often favors a more active southern U.S. storm track and milder northern-tier conditions; the relationship varies across regions and events. A warmer seasonal average can still contain a cold outbreak. Atmospheric variability, including the MJO and blocking patterns, can affect individual weeks. For a city, use the actual regional seasonal outlook, then local forecasts and warnings for storm timing, snow levels and safety.'
  },
  {
    id: 'hurricane-impact',
    category: 'weather',
    categoryLabel: 'Weather & Hurricanes',
    question: 'How does ENSO influence Atlantic and Pacific hurricane seasons?',
    answer: 'El Niño tends to increase vertical wind shear over parts of the tropical Atlantic, making hurricane development less favorable, while often favoring activity in the central and eastern North Pacific. La Niña tends to favor the opposite Atlantic environment. These are seasonal tendencies, not guaranteed storm counts or a rule that La Niña produces a hyperactive season. Atlantic sea temperatures, moisture and other circulation patterns also matter. ENSO cannot determine an individual storm’s track, intensity or landfall; even a quieter season can produce a destructive landfall.'
  },
  {
    id: 'data-refresh-cadence',
    category: 'data',
    categoryLabel: 'Indices & Methods',
    question: 'Where does ENSOLens source its observations and how often are they refreshed?',
    answer: 'ENSOLens checks NOAA CPC sources every six hours. That is a retrieval schedule, not six-hourly new observations. The dashboard labels the weekly conventional Niño 3.4 anomaly separately from the three-month RONI series, the diagnostic discussion and seasonal phase probabilities. Each source retains its observation or issue date and check time. Monthly discussion releases normally follow CPC’s published second-Thursday schedule. Validation failures preserve the last accepted values and show a delayed-source notice; the status endpoint reports the affected feed. A successful check does not mean the source published new values.'
  }
];

const answerSources: Record<string, {href:string; label:string; note:string}[]> = {
  'event-duration': [{href:'https://oceanservice.noaa.gov/facts/ninonina.html',label:'NOAA: ENSO duration',note:'Updated September 23, 2026; checked November 13.'},{href:'/forecast/when-will-it-end/#double-dip-heading',label:'Multi-winter episodes and neutral intervals',note:'With dated NOAA mechanism source.'}],
  'local-weather-guarantee': [{href:'https://www.weather.gov/mhx/ensowhat',label:'NWS: typical ENSO winter patterns',note:'Undated background; checked November 12, 2026.'},{href:'/winter-outlook/',label:'Dated U.S. seasonal outlook and forecast horizons',note:'Regional probabilities and local forecast routing.'}],
  'hurricane-impact': [{href:'https://www.climate.gov/news-features/blogs/enso/impacts-el-nino-and-la-nina-hurricane-season',label:'NOAA: ENSO and hurricane-season mechanisms',note:'May 30, 2014; archived background, checked November 13, 2026. Its 2014 outlook is not current guidance.'},{href:'https://www.nhc.noaa.gov/',label:'NHC current advisories',note:'For individual storms.'}],
  'data-refresh-cadence': [{href:'/methodology/',label:'Sources, products and validation',note:'ENSOLens implementation and source definitions.'},{href:'/api/status/',label:'Live source-check status',note:'Check and retrieval timestamps for each feed.'}],
  'nino-34-threshold': [{href:'https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso/roni/strengths/',label:'CPC strength definitions',note:'Three-month RONI categories; checked November 13, 2026.'}],
  'oni-vs-roni': [{href:'/methodology/#indices',label:'ONI, RONI and weekly anomaly methods',note:'Product-specific CPC references and baselines.'}],
  'super-el-nino': [{href:'/forecast/#strength-heading',label:'Dated strength probabilities and thresholds',note:'November 2026 CPC reference.'}]
};
const faqSchema = {
  mainEntity: {
    '@type': 'FAQPage',
    mainEntity: faqs.map(item => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer.replace(/\n/g, '<br />')
      }
    }))
  }
};
---

<Layout
  title="ENSO FAQ: El Niño, La Niña & Climate Index Questions"
  description="Source-linked answers to common questions about El Niño, La Niña, Niño 3.4 anomalies, NOAA alerts, and seasonal climate impacts."
  active="faq"
  extraSchema={faqSchema}
>
  <div class="page-shell subpage">
    <div class="page-intro">
      <div>
        <span class="eyebrow">FREQUENTLY ASKED QUESTIONS · CLIMATE CONTEXT</span>
        <h1>Understanding ENSO.<br /><span>Clear answers to complex science.</span></h1>
        <p>Source-linked explanations of oceanic indices, NOAA alert criteria, and seasonal climate influences.</p>
      </div>
    </div>

    <div class="faq-controls">
      <div class="faq-search-box">
        <Search size={18} />
        <input
          id="faq-search"
          type="search"
          placeholder="Search questions (e.g. RONI, Advisory, Hurricane, Duration)..."
          aria-label="Search frequently asked questions"
        />
      </div>
      <div class="faq-filter-bar" role="group" aria-label="Filter questions by category">
        <button class="faq-filter-btn active" data-category="all" aria-pressed="true">All Questions</button>
        <button class="faq-filter-btn" data-category="fundamentals" aria-pressed="false">Fundamentals</button>
        <button class="faq-filter-btn" data-category="alerts" aria-pressed="false">Alerts & Forecasts</button>
        <button class="faq-filter-btn" data-category="weather" aria-pressed="false">Weather & Hurricanes</button>
        <button class="faq-filter-btn" data-category="data" aria-pressed="false">Indices & Methods</button>
      </div>
    </div>

    <section class="faq-section" aria-label="Questions list">
      <div id="faq-list" class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" id={faq.id} data-category={faq.category}>
            <summary class="faq-question">
              <span class="faq-question-text">
              <span class="faq-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="faq-category-tag">{faq.categoryLabel}</span>
                <span class="faq-title">{faq.question}</span>
              </span>
              <ChevronRight size={18} class="faq-chevron" />
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
              {['enso-basics', 'el-nino-vs-la-nina'].includes(faq.id) && <p>Mechanism reviewed November 12, 2026. Read our <a href="/methodology/#ocean-atmosphere-heading">ocean–atmosphere coupling guide</a>, with <a href="https://www.weather.gov/fwd/basics">NWS source explanation</a>.</p>}
              {faq.id === 'alerts-explained' && <p>Source: <a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso_advisory/enso-alert-readme.shtml" target="_blank" rel="noreferrer">CPC ENSO Alert System definitions</a>, checked November 12, 2026.</p>}
              {answerSources[faq.id]?.map(source => <p class="answer-source"><a href={source.href}>{source.label}</a> — {source.note}</p>)}
              <div class="faq-footer">
                <a class="faq-anchor-link" href={`#${faq.id}`} title="Direct link to this question">Direct link #</a>
              </div>
            </div>
          </details>
        ))}
      </div>
      <div id="faq-empty" class="faq-empty" hidden>
        <CircleHelp size={32} />
        <p>No questions matched your search query. Try searching for "RONI", "Threshold", or "Watch".</p>
      </div>
    </section>

    <div class="source-callout">
      <BookOpen size={20} />
      <div>
        <strong>Looking for technical definitions or raw equations?</strong>
        <p>Index and strength definitions reviewed November 10, 2026: <a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso/roni/" target="_blank" rel="noreferrer">CPC RONI method</a>, <a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso/oni/v6/" target="_blank" rel="noreferrer">ONI method</a> and <a href="https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso/roni/strengths/" target="_blank" rel="noreferrer">strength categories</a>. <a href="/forecast/#super-el-nino-heading">Read the strength explainer</a>.</p>
      </div>
      <a href="/methodology/">Sources & methods <ArrowUpRight size={15} /></a>
    </div>
  </div>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#faq-search');
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.faq-filter-btn');
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
    const emptyState = document.querySelector<HTMLElement>('#faq-empty');

    let currentCategory = 'all';
    let searchQuery = '';

    function updateFaqVisibility() {
      let visibleCount = 0;
      faqItems.forEach(item => {
        const itemCategory = item.dataset.category || '';
        const textContent = (item.textContent || '').toLowerCase();
        const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
        const matchesSearch = !searchQuery || textContent.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.hidden = false;
          visibleCount++;
        } else {
          item.hidden = true;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      updateFaqVisibility();
    });

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');
        currentCategory = button.dataset.category || 'all';
        updateFaqVisibility();
      });
    });

    // Auto-expand question if targeted by URL hash
    if (window.location.hash) {
      const target = document.querySelector<HTMLDetailsElement>(window.location.hash);
      if (target) {
        target.open = true;
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }
  </script>
</Layout>
