---
import Layout from '../layouts/Layout.astro';
import ForecastChart from '../components/ForecastChart.astro';
import DataNotice from '../components/DataNotice.astro';
import { env } from 'cloudflare:workers';
import { getData } from '../lib/data';
import { seasonLabel } from '../lib/enso';
import { ArrowUpRight, GitCompareArrows, CalendarDays } from '@lucide/astro';
const { snapshot, stale } = await getData(env);
const forecast = snapshot.forecast.data;
const target = forecast.rows.find(row => row.season === 'DJF') ?? forecast.rows[0];
const previous = snapshot.previous?.rows.find(row => row.key === target.key);
const delta = previous ? target.nino - previous.nino : null;
---
<Layout title="ENSO Forecast & Probability Changes" active="forecast" description="Official NOAA CPC ENSO probabilities with dated seasonal targets and comparisons against the previous monthly issue.">
  <div class="page-shell subpage">
    <div class="page-intro"><div><span class="eyebrow">SEASONAL PROBABILITIES</span><h1>The outlook, <span>in perspective.</span></h1><p>Official CPC issue {forecast.issue}. Compare the same season across different issues.</p></div></div>
    <DataNotice stale={stale} />
    <div class="forecast-summary"><div><span class="eyebrow">{seasonLabel(target)} OUTLOOK</span><div class="forecast-big">{target.nino}<span>%</span></div><p>El Niño probability · {seasonLabel(target)}</p></div><div class="forecast-revision"><GitCompareArrows size={23} /><div><strong>{delta === null ? 'Comparison unavailable' : (delta > 0 ? '+' : '') + delta + ' percentage points'}</strong><p>{previous ? previous.nino + '% in ' + snapshot.previous!.issue + ' to ' + target.nino + '% in ' + forecast.issue + '. Both estimates refer to ' + seasonLabel(target) + '.' : 'No verified previous estimate exists for this target season.'}</p></div></div></div>
    <ForecastChart expanded snapshot={snapshot} />
    <section class="explanation-grid"><div><span class="eyebrow">READING THE CHART</span><h2>Three outcomes. One season.</h2><p>Each bar represents a three-month season. The three probabilities add up to approximately 100%, allowing for rounding. OND means October–December; DJF means December–February.</p></div><div><span class="eyebrow">COMPARING ISSUES</span><h2>Keep the target season fixed.</h2><p>Bars are matched by season and year. A target outside the previous issue's forecast horizon is left blank, never treated as zero probability.</p></div></section>
    <div class="source-callout"><CalendarDays size={20} /><div><strong>Original probabilities: NOAA / CPC.</strong><p>Probabilities use CPC's Relative Oceanic Niño Index framework. ENSOLens does not produce its own forecast.</p></div><a href={forecast.source} target="_blank" rel="noreferrer">Open CPC probabilities <ArrowUpRight size={15} /></a></div>
  </div><script>import { initCharts } from '../scripts/charts'; initCharts();</script>
</Layout>
