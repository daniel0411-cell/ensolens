---
import Layout from '../layouts/Layout.astro';
import { Download, ArrowUpRight, Clock, Flame, Snowflake } from '@lucide/astro';
import { env } from 'cloudflare:workers';
import { getData } from '../lib/data';
import historicalData from '../data/historical-analogs.json';

const { snapshot } = await getData(env);

// Filter current 2026 weeks and map to week index
const weeks2026 = snapshot.weekly.data
  .filter(p => p.date.startsWith('2026'))
  .map((p, index) => ({
    week: index + 1,
    date: p.date,
    anomaly: p.anomaly,
    sst: p.sst
  }));

const payload = JSON.stringify({
  current: weeks2026,
  benchmarks: historicalData.benchmarks
}).replace(/</g, '\\u003c');
---

<Layout
  title="Historical Analog Events: 1997, 2015, 2023 vs Today"
  description="Compare current Niño 3.4 weekly anomalies against defining modern climate benchmarks: 1997-98 Monster El Niño, 2015-16 Super El Niño, and 2020-23 La Niña."
  active="historical"
>
  <div class="page-shell subpage">
    <div class="page-intro">
      <div>
        <span class="eyebrow">HISTORICAL BENCHMARKS · 1982–2026</span>
        <h1>Analog Event Comparison.<br /><span>How 2026 measures up to history.</span></h1>
        <p>Compare observed weekly Niño 3.4 departures against the landmark El Niño and La Niña events of modern satellite climate observation.</p>
      </div>
    </div>

    <!-- Analog Interactive Chart Section -->
    <section class="trend-section analog-chart-section" aria-labelledby="analog-heading">
      <div class="section-heading">
        <div>
          <span class="eyebrow">ANNUAL CYCLE TRAJECTORY</span>
          <h2 id="analog-heading">Niño 3.4 weekly anomaly progression</h2>
        </div>
        <button class="icon-button download-analog-data" title="Download official historical analog data (CSV)" aria-label="Download official historical analog data as CSV">
          <Download size={17} />
        </button>
      </div>

      <div class="chart-toolbar analog-toolbar">
        <div class="analog-legend-pills">
          <span class="analog-current-pill">
            <i class="legend-dot current-glow"></i>2026 (Current)
          </span>
          {historicalData.benchmarks.map(b => (
            <button
              class="analog-toggle-pill active"
              data-analog-toggle={b.id}
              aria-pressed="true"
              style={`--pill-color: ${b.color};`}
            >
              <i class="legend-dot" style={`background-color: ${b.color};`}></i>
              {b.shortName}
            </button>
          ))}
        </div>
      </div>

      <div class="line-chart-wrap analog-canvas-wrap">
        <canvas id="analog-chart" role="img" aria-label="Interactive multi-line chart comparing 2026 weekly Niño 3.4 anomalies against benchmark years 1997, 2015, 2020, and 2023"></canvas>
      </div>
      <script id="analog-data" type="application/json" set:html={payload} />

      <div class="chart-footer">
        <span>OFFICIAL NOAA CPC WEEKLY DATA · 1991–2020 BASELINE</span>
        <a href="/methodology/#indices">Understand Niño 3.4 calculation <ArrowUpRight size={13} /></a>
      </div>
      <p class="figure-note">X-axis represents weeks 1 through 52 of each annual progression. Click benchmark buttons above to isolate specific historical trajectories.</p>
    </section>

    <!-- Benchmark Deep-Dive Profiles -->
    <section class="analog-profiles-section">
      <div class="section-header-compact">
        <span class="eyebrow">EVENT PROFILES</span>
        <h2>The modern climate benchmarks</h2>
        <p>Four events that redefined global understanding of equatorial Pacific ocean-atmosphere coupling.</p>
      </div>

      <div class="analog-cards-grid">
        <article class="analog-card el-nino-2015">
          <div class="analog-card-header">
            <div class="analog-card-icon warm"><Flame size={22} /></div>
            <div>
              <span class="event-tag super-nino">Super El Niño</span>
              <h3>2015–2016 Event</h3>
            </div>
          </div>
          <div class="analog-metric-row">
            <div>
              <span class="analog-metric-label">PEAK ANOMALY</span>
              <span class="analog-metric-val">+3.0°C</span>
            </div>
            <div>
              <span class="analog-metric-label">PEAK TIMING</span>
              <span class="analog-metric-sub">Mid-November 2015</span>
            </div>
          </div>
          <p class="analog-card-text">
            The highest recorded weekly Niño 3.4 anomaly (+3.0°C) of the modern satellite era. Produced unprecedented central Pacific tropical cyclone activity (including Category 5 Hurricane Patricia) and catalyzed the longest global coral bleaching event on record.
          </p>
          <div class="analog-card-footer">
            <span class="analog-badge">Historic Global Ocean Heat</span>
          </div>
        </article>

        <article class="analog-card el-nino-1997">
          <div class="analog-card-header">
            <div class="analog-card-icon amber"><Flame size={22} /></div>
            <div>
              <span class="event-tag super-nino">Super El Niño</span>
              <h3>1997–1998 Event</h3>
            </div>
          </div>
          <div class="analog-metric-row">
            <div>
              <span class="analog-metric-label">PEAK ANOMALY</span>
              <span class="analog-metric-val">+2.3°C</span>
            </div>
            <div>
              <span class="analog-metric-label">PEAK TIMING</span>
              <span class="analog-metric-sub">Late November 1997</span>
            </div>
          </div>
          <p class="analog-card-text">
            The landmark reference El Niño of modern meteorology and the first observed in real time by the TAO/TRITON moored buoy array. Generated devastating atmospheric river storms across California, torrential floods in coastal Peru, and historic wildfires across Indonesia.
          </p>
          <div class="analog-card-footer">
            <span class="analog-badge">First Real-Time Buoy Array</span>
          </div>
        </article>

        <article class="analog-card el-nino-2023">
          <div class="analog-card-header">
            <div class="analog-card-icon pink"><Flame size={22} /></div>
            <div>
              <span class="event-tag strong-nino">Strong El Niño</span>
              <h3>2023–2024 Event</h3>
            </div>
          </div>
          <div class="analog-metric-row">
            <div>
              <span class="analog-metric-label">PEAK ANOMALY</span>
              <span class="analog-metric-val">+2.1°C</span>
            </div>
            <div>
              <span class="analog-metric-label">PEAK TIMING</span>
              <span class="analog-metric-sub">Mid-December 2023</span>
            </div>
          </div>
          <p class="analog-card-text">
            Emerged with historic speed following the prolonged 2020–2023 triple-dip La Niña. Accelerated unprecedented global sea surface temperature records, drove severe drought across the Amazon River basin, and contributed to extreme heat worldwide.
          </p>
          <div class="analog-card-footer">
            <span class="analog-badge">Rapid Cold-to-Warm Transition</span>
          </div>
        </article>

        <article class="analog-card la-nina-2020">
          <div class="analog-card-header">
            <div class="analog-card-icon cyan"><Snowflake size={22} /></div>
            <div>
              <span class="event-tag strong-nina">Triple-Dip La Niña</span>
              <h3>2020–2023 Event</h3>
            </div>
          </div>
          <div class="analog-metric-row">
            <div>
              <span class="analog-metric-label">PEAK ANOMALY</span>
              <span class="analog-metric-val">-1.4°C</span>
            </div>
            <div>
              <span class="analog-metric-label">PEAK TIMING</span>
              <span class="analog-metric-sub">November 2020</span>
            </div>
          </div>
          <p class="analog-card-text">
            A rare three-year multi-winter La Niña sequence. Intensified the 2020 record Atlantic hurricane season (30 named storms), prolonged severe drought across the American Southwest, and generated historic multi-year flooding across eastern Australia.
          </p>
          <div class="analog-card-footer">
            <span class="analog-badge">Record 30-Storm Atlantic Season</span>
          </div>
        </article>
      </div>
    </section>

    <!-- Historical Reference Table -->
    <section class="analog-table-section">
      <div class="section-header-compact">
        <span class="eyebrow">COMPARATIVE MATRIX</span>
        <h2>Benchmark comparison summary</h2>
        <p>Key oceanographic statistics and observed global teleconnections across major modern episodes.</p>
      </div>

      <div class="table-container">
        <table class="analog-summary-table">
          <thead>
            <tr>
              <th scope="col">Event</th>
              <th scope="col">Classification</th>
              <th scope="col">Peak Niño 3.4</th>
              <th scope="col">Peak Season</th>
              <th scope="col">Atlantic Activity</th>
              <th scope="col">Key Global Teleconnections</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>2015–2016</strong></td>
              <td><span class="table-badge warm">Super El Niño</span></td>
              <td><strong>+3.0°C</strong></td>
              <td>OND 2015</td>
              <td>Suppressed (ACE 63)</td>
              <td>Record Central Pacific hurricanes; historic global coral bleaching; severe Ethiopian drought.</td>
            </tr>
            <tr>
              <td><strong>1997–1998</strong></td>
              <td><span class="table-badge warm">Super El Niño</span></td>
              <td><strong>+2.3°C</strong></td>
              <td>NDJ 1997–98</td>
              <td>Suppressed (ACE 41)</td>
              <td>Torrential California storms & atmospheric rivers; Peru flooding; severe SE Asia forest fires.</td>
            </tr>
            <tr>
              <td><strong>2023–2024</strong></td>
              <td><span class="table-badge warm">Strong El Niño</span></td>
              <td><strong>+2.1°C</strong></td>
              <td>DJF 2023–24</td>
              <td>Counterbalanced by extreme Atlantic SST</td>
              <td>Severe Amazon River low water records; Southern Africa mid-summer drought; warm boreal winter.</td>
            </tr>
            <tr>
              <td><strong>2020–2023</strong></td>
              <td><span class="table-badge cold">Triple-Dip La Niña</span></td>
              <td><strong>-1.4°C</strong></td>
              <td>OND 2020</td>
              <td>Hyperactive (Record 30 storms in 2020)</td>
              <td>Persistent Southwest US megadrought; historic multi-year Australian flooding; Horn of Africa drought.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="source-callout">
      <Clock size={20} />
      <div>
        <strong>Examining upcoming seasonal probabilities?</strong>
        <p>Official 9-season model consensus probabilities are updated monthly by the Climate Prediction Center.</p>
      </div>
      <a href="/forecast/">Explore official forecast <ArrowUpRight size={15} /></a>
    </div>
  </div>

  <script>
    import { initCharts } from '../scripts/charts';
    initCharts();
  </script>
</Layout>
